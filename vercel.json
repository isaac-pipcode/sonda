{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "true",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,tests/**,docs/**,fixtures/**,data/fsa.db,**/__pycache__/**}",
      "includeFiles": "{data/fsa.db.sha256,schema.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
