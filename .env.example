# Backend (contêiner) — use a connection string POOLED do Postgres gerenciado.
# Neon exemplo (note o '-pooler' no host e sslmode=require):
SONDA_DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.sa-east-1.aws.neon.tech/sonda?sslmode=require
SONDA_POOL_MAX=10

# Frontend: só se a API estiver em OUTRO domínio (ex.: Fly). Na Vercel, com a API em /api, deixe sem definir.
# VITE_SONDA_API=https://sonda-api.fly.dev
# RIDAB (Parquet remoto no Hugging Face): revisão fixada e prefixo alternativo opcional.
# SONDA_RIDAB_REV=6c5e6ae1ce5a866b76039e1f3dce7776cf22dfe1
# SONDA_RIDAB_BASE=

# CORS da API (backend). Sem estas variáveis, a API libera qualquer origem ("*"): só para desenvolvimento.
# Em produção, liste as origens do front (separadas por vírgula, sem barra final)
# e, se quiser os previews da Vercel, um regex.
# SONDA_CORS_ORIGINS=https://sonda.vercel.app,https://sonda.pipcode.dev
# SONDA_CORS_ORIGIN_REGEX=^https://sonda-[a-z0-9-]+-pipcode-dev\.vercel\.app$

# Base FSA hospedada fora do git; baixada no primeiro uso (serverless) ou pelo baixar_fsa.py.
SONDA_FSA_URL=https://github.com/isaac-pipcode/sonda/releases/download/fsa.db/fsa.db
